<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical" >

    <!-- Inline emoji search: the typed words are shown here and the results filter live -->
    <LinearLayout
        android:id="@+id/emoji_search_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-18dp"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/emoji_search_field"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/emoji_search_field_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/ks_search"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/emoji_search_query"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textSize="16sp" />
            <View
                android:id="@+id/emoji_search_cursor"
                android:layout_width="2dp"
                android:layout_height="20dp"
                android:layout_marginStart="1dp" />
            <TextView
                android:id="@+id/emoji_search_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:text="@string/emoji_search_title"
                android:textSize="16sp" />
            <!-- pushes the close button to the far right -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <ImageView
                android:id="@+id/emoji_search_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="9dp"
                android:src="@drawable/ic_close"
                android:contentDescription="@string/spoken_description_action_previous" />
        </LinearLayout>
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:scrollbars="none"
            android:overScrollMode="never">
            <LinearLayout
                android:id="@+id/emoji_search_results"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />
        </HorizontalScrollView>
    </LinearLayout>

    <include
        android:id="@+id/strip_container"
        layout="@layout/strip_container" />

    <!-- To ensure that key preview popup is correctly placed when the current system locale is
         one of RTL locales, layoutDirection="ltr" is needed in the SDK version 17+. -->
    <com.perfectkey.keyboard.latin.KeyboardWrapperView
        android:id="@+id/keyboard_view_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr" >

        <com.perfectkey.keyboard.keyboard.MainKeyboardView
            android:id="@+id/keyboard_view"
            android:layoutDirection="ltr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <include
            android:id="@+id/emoji_palettes_view"
            layout="@layout/emoji_palettes_view" />
        <include
            android:id="@+id/clipboard_history_view"
            layout="@layout/clipboard_history_view" />

        <ImageButton
            android:id="@+id/btn_stop_one_handed_mode"
            android:contentDescription="@string/label_stop_onehanded_mode_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scaleType="fitCenter"
            style="?attr/suggestionWordStyle" />

        <ImageButton
            android:id="@+id/btn_switch_one_handed_mode"
            android:contentDescription="@string/label_switch_onehanded_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scaleType="fitCenter"
            style="?attr/suggestionWordStyle" />

        <ImageButton
            android:id="@+id/btn_resize_one_handed_mode"
            android:contentDescription="@string/label_resize_onehanded_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scaleType="fitCenter"
            style="?attr/suggestionWordStyle" />
    </com.perfectkey.keyboard.latin.KeyboardWrapperView>

    <!-- Takes over the system bottom inset from the keyboard view; the emoji key lives in the bottom row -->
    <FrameLayout
        android:id="@+id/bottom_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/float_handle_container"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/resize_handle"
            android:layout_weight="1"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/config_floating_handle_height"
            android:src="@drawable/ic_arrow_horizontal"/>
        <ImageView
            android:id="@+id/drag_handle"
            android:layout_weight="1"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/config_floating_handle_height"
            android:src="@drawable/ic_drag_indicator"/>
    </LinearLayout>
</LinearLayout>
