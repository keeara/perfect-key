            <solid android:color="#17000000" />
            <padding android:top="0dp" android:right="0dp" android:bottom="1dp" android:left="0dp" />
        </shape>
    </item>
    <!-- Popup background -->
    <!-- fill is a bit darker than the edge line, so the pill gets the same soft rim light as the keys -->
    <item>
        <shape>
            <corners android:radius="13dp" />
            <gradient android:angle="270" android:startColor="#FFFFFF" android:endColor="#EAEAEA" />
            <stroke android:width="1dp" android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>